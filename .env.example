JWT_SECRET=replace_me_with_a_strong_secret
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db>?retryWrites=true&w=majority

# WebRTC relay configuration
# Option A: Cloudflare dynamic TURN credentials
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
# Optional aliases matching Cloudflare curl docs
TURN_KEY_API_TOKEN=
TURN_KEY_ID=
CLOUDFLARE_TURN_TTL=86400

# Option B: Static TURN credentials fallback
# Example TURN_URL: turn:global.relay.metered.ca:80?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
